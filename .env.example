FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=sparepro-super-secret-key-change-in-production-2026

# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=sparepro_db
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/sparepro_db

# Application Configuration
ITEMS_PER_PAGE=12
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# SMTP Email Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_TIMEOUT=10
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=support@sparepro.local
